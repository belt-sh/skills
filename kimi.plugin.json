{
  "name": "belt",
  "version": "1.0.0",
  "description": "Belt — the cloud platform for AI agents. Run hundreds of AI apps, manage knowledge, search and publish skills, connect MCP servers.",
  "author": {
    "name": "inference.sh"
  },
  "homepage": "https://belt.sh",
  "license": "MIT",
  "keywords": ["belt", "skills", "knowledge", "ai", "agents"],
  "hooks": [
    {
      "event": "SessionStart",
      "command": "${KIMI_PLUGIN_ROOT}/scripts/hook-session-start.sh",
      "timeout": 60
    },
    {
      "event": "UserPromptSubmit",
      "command": "${KIMI_PLUGIN_ROOT}/scripts/hook-user-prompt.sh",
      "timeout": 3
    },
    {
      "event": "PreToolUse",
      "matcher": "Read",
      "command": "${KIMI_PLUGIN_ROOT}/scripts/hook-post-tool.sh",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "command": "${KIMI_PLUGIN_ROOT}/scripts/hook-post-tool.sh",
      "timeout": 3
    },
    {
      "event": "Stop",
      "command": "${KIMI_PLUGIN_ROOT}/scripts/hook-stop.sh",
      "timeout": 60
    }
  ],
  "interface": {
    "displayName": "belt",
    "shortDescription": "inference.sh — hundreds of AI apps, skills registry, cross-session memory"
  }
}
