{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-user-prompt.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-post-tool.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-stop.sh",
            "timeout": 5
          },
          {
            "type": "prompt",
            "prompt": "Did the assistant discover something non-obvious worth persisting as knowledge? (debugging insight, architectural pattern, API behavior, user preference). If yes, respond {\"ok\": false, \"reason\": \"Worth saving as [type]: [title] — [1-2 sentence summary]\"}. If nothing worth saving, respond {\"ok\": true}."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-session-end.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
