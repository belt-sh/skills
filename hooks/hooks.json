{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/belt-hook-log.sh SessionStart; exit 0",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/belt-hook-log.sh UserPromptSubmit | belt suggest --json 2>/dev/null; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/belt-hook-log.sh PostToolUse; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/belt-hook-log.sh Stop; exit 0",
            "timeout": 5000
          },
          {
            "type": "prompt",
            "prompt": "Did the assistant discover something non-obvious worth persisting as knowledge? (debugging insight, architectural pattern, API behavior, user preference). If yes, respond {\"ok\": false, \"reason\": \"Worth saving as [type]: [title] — [1-2 sentence summary]\"}. If nothing worth saving, respond {\"ok\": true}."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/belt-hook-log.sh SessionEnd; echo \"$input\" | belt claude session-end 2>/dev/null; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
