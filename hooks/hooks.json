{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [SessionStart] $(echo $input | head -c 500)\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [UserPromptSubmit] $(echo $input | head -c 200)\" >> ~/.belt/hooks.log; echo \"$input\" | belt suggest --json 2>/dev/null; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [PostToolUse] $(echo $input | head -c 200)\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [Stop] $(echo $input | head -c 500)\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 5000
          },
          {
            "type": "prompt",
            "prompt": "Did the assistant discover something non-obvious worth persisting as knowledge? (debugging insight, architectural pattern, API behavior, user preference). If yes, respond {\"ok\": false, \"reason\": \"Worth saving as [type]: [title] — [1-2 sentence summary]\"}. If nothing worth saving, respond {\"ok\": true}."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [SessionEnd] $(echo $input | head -c 500)\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
