{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [SessionStart]\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [UserPromptSubmit] $(echo $input | head -c 200)\" >> ~/.belt/hooks.log; echo \"$input\" | belt suggest --json 2>/dev/null; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && input=$(cat) && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [PostToolUse] $(echo $input | head -c 200)\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [Stop]\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.belt && echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) [SessionEnd]\" >> ~/.belt/hooks.log; exit 0",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
